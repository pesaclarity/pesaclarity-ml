#!/usr/bin/env bash
# Run the repository's checks on this machine (they used to run in GitHub CI).
#
#   tool/check          everything: lint, types and all tests with the [torch] and
#                       [fl] extras, the smoke runs, then the core-only install,
#                       and the accountants' figures
#   tool/check --fast   format, lint, types and the tests your environment can run
#                       (the torch tests run only if the [torch] extra is installed)
#
# The full check fetches rayo's C sources once, to run the converted files (RAYO_DIR
# names a rayo checkout to use instead).
#
# The pre-push hook runs the full check. Needs uv: https://docs.astral.sh/uv/
set -euo pipefail
cd "$(dirname "$0")/.."

fast=false
case "${1:-}" in
  "") ;;
  --fast) fast=true ;;
  -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "Unknown option: $1 (try --fast or --help)" >&2; exit 2 ;;
esac

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is not installed. Install it: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

# Quiet MLflow, as CI did.
export MLFLOW_DISABLE_AGENT_HINT=1

# step "<name>" "<how to fix>" command...
step() {
  local name=$1 fix=$2
  shift 2
  echo
  echo "==> $name"
  local start=$SECONDS
  if ! "$@"; then
    echo
    echo "FAILED: $name"
    echo "  Fix: $fix"
    exit 1
  fi
  echo "    ok ($((SECONDS - start))s)"
}

if $fast; then
  # --inexact keeps any extras you have installed instead of removing them.
  run=(uv run --locked --inexact)
else
  # Full check uses the [torch] and federated extras.
  run=(uv run --locked --extra torch --extra fl)
fi

step "ruff format" "run 'uv run ruff format .'" "${run[@]}" ruff format --check .
step "ruff lint" "run 'uv run ruff check --fix .' and fix the rest by hand" "${run[@]}" ruff check .
step "mypy" "fix the type errors listed above" "${run[@]}" mypy

if $fast; then
  step "pytest" "fix the failing tests above" "${run[@]}" pytest
  echo
  echo "Fast checks passed. Run tool/check for everything (the pre-push hook does)."
  exit 0
fi

# rayo's C library runs the converted files, built from rayo's sources at the commit
# pyproject.toml pins.
rayo_sources() {
  local commit dir
  # A git hook exports GIT_DIR (and in a linked worktree GIT_INDEX_FILE and
  # friends). Left set, `git init` below would re-initialise this repository
  # (setting core.bare) instead of creating the new one, and the fetch would fail.
  # This function runs in a $(...) subshell, so unsetting them here is local.
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX
  commit=$(grep -o 'pesaclarity/rayo@[0-9a-f]\{40\}' pyproject.toml | head -1 | cut -d@ -f2)
  dir=".cache/rayo/$commit"
  if [ ! -f "$dir/src/model.c" ]; then
    rm -rf "$dir"
    mkdir -p "$dir" || return 1
    # Every git call names the new repository explicitly: with -C alone, a failed
    # init (a full disk, say) would leave the commands below working on this
    # checkout instead.
    git init -q "$dir" && [ -d "$dir/.git" ] || { rm -rf "$dir"; return 1; }
    local g=(git --git-dir="$dir/.git" --work-tree="$dir")
    { "${g[@]}" sparse-checkout set src include >/dev/null &&
      "${g[@]}" fetch -q --depth 1 --filter=blob:none https://github.com/pesaclarity/rayo "$commit" &&
      "${g[@]}" checkout -q FETCH_HEAD; } || { rm -rf "$dir"; return 1; }
  fi
  echo "$PWD/$dir"
}
if [ -z "${RAYO_DIR:-}" ]; then
  RAYO_DIR=$(rayo_sources) || {
    echo "    (could not fetch rayo's sources: the tests that run rayo's C library skip)"
    RAYO_DIR=
  }
fi
export RAYO_DIR

fix_smoke="rerun the command above and read its error; see README.md"
step "no TensorFlow" "keep TensorFlow out of the dependencies (decision 0023, stage 5)" \
  "${run[@]}" python -c "import importlib.util as u, sys; sys.exit(u.find_spec('tensorflow') is not None)"
step "pytest (all, with extras)" "fix the failing tests above" "${run[@]}" pytest
step "smoke: train" "$fix_smoke" "${run[@]}" akili train --config configs/smoke.yaml
step "smoke: train DP-SGD" "$fix_smoke" "${run[@]}" akili train --config configs/dp-sgd.yaml
step "smoke: federated simulation" "$fix_smoke" \
  "${run[@]}" akili simulate --config configs/federated-smoke.yaml
# Quick audit runs the attacks end to end; too small to pass, so report only.
step "quick privacy audit (report only)" "$fix_smoke" \
  "${run[@]}" akili audit --quick --report-only \
  --config configs/audit-no-dp.yaml --config configs/audit-dp-sgd.yaml

# The core install (no extras) must work on its own. --isolated builds a
# throwaway environment, so your .venv keeps its extras.
core=(uv run --locked --isolated)
step "mypy (core install, no extras)" "keep optional extras out of core imports" "${core[@]}" mypy
step "pytest (core install, no extras)" "keep optional extras out of core code and tests" \
  "${core[@]}" pytest
# The accountants need Opacus, which is in the [torch] extra, not core. dp-accounting's
# signed-off figures are read from the file; Opacus's are recomputed.
step "accountants match accountants.v1.json" \
  "run 'uv run --extra torch akili accountants' and say in the pull request why the figures moved" \
  "${run[@]}" akili accountants --check

echo
echo "All checks passed."
